// ============================================================================
// COCKPIT — LIQUIDITY MARKING
//
// Implements the marking rules from strategy/01-market-structure.md, using the
// Universal Definitions given 2026-08-26.
//
// This is chart preparation, not a signal. It marks levels I defined.
// It never says enter, exit, long or short.
//
// UNIVERSAL DEFINITIONS THIS CODE FOLLOWS
//   High / Low     = WICK extreme, never the body
//   Blue / Black   = bullish / bearish candle
//   "Together"     = CONSECUTIVE, ADJACENT candles of DIFFERENT colour
//   Recent         = the MOST RECENT valid structure, not a candle count
//   Liquidity hit  = WICK TOUCH (body close not required)
//   BOS            = BODY CLOSE beyond the structural level
//
//   Liquidity hit and BOS are deliberately different events. A wick takes
//   liquidity. A body close breaks structure.
//
// IMPLEMENTED
//   * Vertical lines: 03:00 London, 09:30 New York, 18:00 Asia
//   * NO 08:00 line — deliberately absent, invisible observation boundary
//   * Asia high/low    18:00 -> 03:00, carried forward
//   * London high/low  03:00 -> 08:00, carried forward
//   * Execution window 09:40-09:45 shaded
//   * Blue/Black structural high and low on the chart timeframe
//   * Forward-candle interaction: a level that gets wicked is greyed and
//     stops extending, because it is no longer fresh liquidity
//
// NOT IMPLEMENTED, ON PURPOSE
//   * 4H highs/lows — my rule is "visible highs and lows from the current
//     active market structure", a judgement I make by eye. No mechanical
//     definition exists, so 4H stays hand-drawn.
//   * BOS markers — defined and codeable, but they mark my TRIGGER rather
//     than my preparation. See BOS_NOTE at the bottom.
//   * Anything resembling an entry.
//
// TIMEZONE: America/New_York, so US daylight saving is handled automatically.
// My notes say UTC-4, which is only correct in summer.
// ============================================================================

//@version=6
indicator("Cockpit — Liquidity Marking", "Cockpit", overlay = true, max_lines_count = 500, max_labels_count = 500)

TZ = "America/New_York"

// ─────────────────────────────────────────────────────────── inputs
gV = "Session vertical lines"
vAsia   = input.bool(true, "18:00  Asia open",     group = gV)
vLondon = input.bool(true, "03:00  London open",   group = gV)
vNY     = input.bool(true, "09:30  New York open", group = gV)
// 08:00 has no input on purpose — invisible observation boundary.

gR = "Session ranges"
rAsia   = input.bool(true, "Asia high/low   (18:00 to 03:00)", group = gR)
rLondon = input.bool(true, "London high/low (03:00 to 08:00)", group = gR)

gS = "Blue/Black structure (this timeframe)"
sShow = input.bool(true, "Mark structural high/low", group = gS)
sKeep = input.int(3, "Untouched levels to keep", minval = 1, maxval = 20, group = gS)

gW = "Execution window"
wShow = input.bool(true, "Highlight 09:40-09:45", group = gW)

gC = "Colours"
cAsia   = input.color(color.new(color.orange, 0), "Asia",         group = gC)
cLondon = input.color(color.new(color.blue,   0), "London",       group = gC)
cHi     = input.color(color.new(color.red,    0), "Structure hi", group = gC)
cLo     = input.color(color.new(color.green,  0), "Structure lo", group = gC)
cHit    = input.color(color.new(color.gray,  55), "Hit / stale",  group = gC)
cVert   = input.color(color.new(color.gray,  40), "Verticals",    group = gC)
cWin    = input.color(color.new(color.teal,  85), "Window",       group = gC)

// ─────────────────────────────────────────────────────────── clock
mins = hour(time, TZ) * 60 + minute(time, TZ)

inAsia   = mins >= 1080 or mins < 180
inLondon = mins >= 180 and mins < 480
inWindow = mins >= 580 and mins < 585

startAsia   = inAsia and not inAsia[1]
startLondon = inLondon and not inLondon[1]
inNY        = mins >= 570 and mins < 960
startNY     = inNY and not inNY[1]

// ─────────────────────────────────────────────────────────── vertical lines
var line vlA = na
var line vlL = na
var line vlN = na

drawVert(bool trig, line prev, color c) =>
    line out = prev
    if trig
        line.delete(prev)
        out := line.new(time, low, time, high, xloc = xloc.bar_time, extend = extend.both, color = c, style = line.style_dotted)
    out

if vAsia
    vlA := drawVert(startAsia, vlA, cVert)
if vLondon
    vlL := drawVert(startLondon, vlL, cVert)
if vNY
    vlN := drawVert(startNY, vlN, cVert)

// ─────────────────────────────────────────────────────────── Asia range
var float aHi  = na
var float aLo  = na
var line  aHiL = na
var line  aLoL = na
var label aHiT = na
var label aLoT = na

if rAsia
    if startAsia
        // one range at a time: "one meaningful liquidity area > multiple redundant lines"
        line.delete(aHiL)
        line.delete(aLoL)
        label.delete(aHiT)
        label.delete(aLoT)
        aHi := high
        aLo := low
        aHiL := line.new(time, aHi, time, aHi, xloc = xloc.bar_time, color = cAsia)
        aLoL := line.new(time, aLo, time, aLo, xloc = xloc.bar_time, color = cAsia)
        aHiT := label.new(time, aHi, "Asia High", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cAsia, 88), textcolor = cAsia, size = size.tiny)
        aLoT := label.new(time, aLo, "Asia Low", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cAsia, 88), textcolor = cAsia, size = size.tiny)
    else if inAsia and not na(aHiL)
        aHi := math.max(aHi, high)
        aLo := math.min(aLo, low)
    if not na(aHiL)
        line.set_y1(aHiL, aHi)
        line.set_y2(aHiL, aHi)
        line.set_x2(aHiL, time)
        line.set_y1(aLoL, aLo)
        line.set_y2(aLoL, aLo)
        line.set_x2(aLoL, time)
        label.set_xy(aHiT, time, aHi)
        label.set_xy(aLoT, time, aLo)

// ─────────────────────────────────────────────────────────── London range
var float lHi  = na
var float lLo  = na
var line  lHiL = na
var line  lLoL = na
var label lHiT = na
var label lLoT = na

if rLondon
    if startLondon
        line.delete(lHiL)
        line.delete(lLoL)
        label.delete(lHiT)
        label.delete(lLoT)
        lHi := high
        lLo := low
        lHiL := line.new(time, lHi, time, lHi, xloc = xloc.bar_time, color = cLondon)
        lLoL := line.new(time, lLo, time, lLo, xloc = xloc.bar_time, color = cLondon)
        lHiT := label.new(time, lHi, "London High", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cLondon, 88), textcolor = cLondon, size = size.tiny)
        lLoT := label.new(time, lLo, "London Low", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cLondon, 88), textcolor = cLondon, size = size.tiny)
    else if inLondon and not na(lHiL)
        lHi := math.max(lHi, high)
        lLo := math.min(lLo, low)
    if not na(lHiL)
        line.set_y1(lHiL, lHi)
        line.set_y2(lHiL, lHi)
        line.set_x2(lHiL, time)
        line.set_y1(lLoL, lLo)
        line.set_y2(lLoL, lLo)
        line.set_x2(lLoL, time)
        label.set_xy(lHiT, time, lHi)
        label.set_xy(lLoT, time, lLo)

// ══════════════════════════════════════════════════════════════════════════
// BLUE / BLACK STRUCTURE
//
// A level exists only where two ADJACENT candles are DIFFERENT colours.
// Within such a pair the marked high is the higher of the two UPPER WICKS,
// and the marked low is the lower of the two LOWER WICKS.
//
// NOTE, flagged in strategy/01-market-structure.md, awaiting confirmation:
// because "candle high" is defined as the wick extreme, the colour selects
// nothing WITHIN a qualifying pair — both stated cases reduce to "the higher
// wick". The colour does its work one step earlier, as the FILTER deciding
// which pairs produce a level at all.
// ══════════════════════════════════════════════════════════════════════════

type Lvl
    float price
    line  ln
    label lb
    bool  hit

var array<Lvl> hiLvls = array.new<Lvl>()
var array<Lvl> loLvls = array.new<Lvl>()

isBlue  = close >= open
isBlack = close < open
pairOK  = (isBlue and isBlack[1]) or (isBlack and isBlue[1])
pairHi  = math.max(high, high[1])
pairLo  = math.min(low, low[1])

addLvl(array<Lvl> arr, float px, color c, string txt) =>
    ln = line.new(time[1], px, time, px, xloc = xloc.bar_time, color = c, width = 1)
    lb = label.new(time, px, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 90), textcolor = c, size = size.tiny)
    array.push(arr, Lvl.new(px, ln, lb, false))
    if array.size(arr) > sKeep
        Lvl gone = array.shift(arr)
        line.delete(gone.ln)
        label.delete(gone.lb)

if sShow and barstate.isconfirmed and pairOK
    addLvl(hiLvls, pairHi, cHi, "H")
    addLvl(loLvls, pairLo, cLo, "L")

// forward-candle interaction: a WICK TOUCH means the level is no longer fresh
if sShow and array.size(hiLvls) > 0
    for i = 0 to array.size(hiLvls) - 1
        Lvl L = array.get(hiLvls, i)
        if not L.hit and high >= L.price
            L.hit := true
            line.set_color(L.ln, cHit)
            line.set_style(L.ln, line.style_dashed)
            label.set_text(L.lb, "H hit")
            label.set_textcolor(L.lb, cHit)
        if not L.hit
            line.set_x2(L.ln, time)
            label.set_x(L.lb, time)

if sShow and array.size(loLvls) > 0
    for i = 0 to array.size(loLvls) - 1
        Lvl L = array.get(loLvls, i)
        if not L.hit and low <= L.price
            L.hit := true
            line.set_color(L.ln, cHit)
            line.set_style(L.ln, line.style_dashed)
            label.set_text(L.lb, "L hit")
            label.set_textcolor(L.lb, cHit)
        if not L.hit
            line.set_x2(L.ln, time)
            label.set_x(L.lb, time)

// ─────────────────────────────────────────────────────────── window
bgcolor(wShow and inWindow ? cWin : na, title = "09:40-09:45 execution window")

// ══════════════════════════════════════════════════════════════════════════
// BOS_NOTE
//
// BOS is now fully defined: a body CLOSE beyond the most recent valid
// structural high (bullish) or low (bearish) — the newest untouched level in
// the arrays above. It would take about a dozen lines.
//
// It is deliberately absent. Marking my levels is preparation; marking my BOS
// is marking my trigger, and a chart that lights up when the setup fires reads
// as a signal whether or not it is labelled one. That is my decision to make
// in review, not the tool's to make by default.
//
// If I want it, it goes in as an OFF-BY-DEFAULT input, and /checktrade still
// runs before every entry regardless of what the chart says.
// ══════════════════════════════════════════════════════════════════════════
